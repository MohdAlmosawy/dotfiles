{
  "version": 1,
  "notes": "Map each physical machine to its Anki profile and Obsidian vault. Collection content is synced via AnkiWeb; paths differ per device. Add new devices here — do not hardcode a single DEFAULT_DB in scripts.",
  "devices": {
    "alsalam-work": {
      "label": "AlSalam work PC",
      "status": "active",
      "match": {
        "hostnames": ["Ubuntu24"],
        "os_hints": ["linux"]
      },
      "anki": {
        "install": "snap",
        "profile_dir": "~/snap/anki-desktop/common/User 1",
        "collection_db": "~/snap/anki-desktop/common/User 1/collection.anki2"
      },
      "obsidian": {
        "vault": "~/Desktop/obsidian/6 AI-Master UOB"
      }
    },
    "personal-laptop": {
      "label": "Personal laptop",
      "status": "active",
      "match": {
        "hostnames": ["Mangroove-Predator-PHN16-71"],
        "os_hints": ["linux"]
      },
      "anki": {
        "install": "native",
        "profile_dir": "~/.local/share/Anki2/Sayed Mohamed",
        "collection_db": "~/.local/share/Anki2/Sayed Mohamed/collection.anki2"
      },
      "obsidian": {
        "vault": "~/Desktop/obsidian/6 AI-Master UOB"
      }
    }
  }
}
